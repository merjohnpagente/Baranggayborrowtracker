.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# NOTE: pubspec.lock is deliberately NOT ignored.
# This is an application, not a library, so the resolved dependency versions
# are part of the build. Committing it is what makes CI resolve the same
# package versions every run instead of drifting to whatever is newest.
# (For a published Dart *package*, the opposite rule applies.)

